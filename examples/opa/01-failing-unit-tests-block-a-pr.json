          ]
        }
      }
    },
    "missing": [],
    "team": {},
    "waivers": [],
    "kill_switches": [],
    "break_glass": null
  },
  "expect": [
    {
      "effect": "block",
      "items": [
        "PaymentRefundTest.partial"
      ],
      "message": "tests.unit failed: PaymentRefundTest.partial",
      "rule": "baseline.tests.unit"
    }
  ]
}
